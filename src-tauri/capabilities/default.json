{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [{"url": "https://api.ergoplatform.com/api/*"}]
    },
    "store:default"
  ]
}